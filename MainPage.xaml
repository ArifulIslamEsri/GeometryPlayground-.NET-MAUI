<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:esri="clr-namespace:Esri.ArcGISRuntime.Maui;assembly=Esri.ArcGISRuntime.Maui"
    x:Class="GeometryPlayground.MainPage">

    <Grid RowDefinitions="*,Auto">

        <!-- ✅ MAP -->
        <esri:MapView x:Name="MyMapView" Grid.Row="0"/>

        <!-- ✅ BUTTON BAR (WORKING VERSION) -->
        <HorizontalStackLayout
            Grid.Row="1"
            Spacing="5"
            Padding="8"
            BackgroundColor="Black">

            <Button Text="Add" Clicked="OnAddClicked"/>
            <Button Text="Delete" Clicked="OnDeleteClicked"/>
            <Button Text="Line" Clicked="OnLineClicked"/>
            <Button Text="Polygon" Clicked="OnPolygonClicked"/>
            <Button Text="Finish" Clicked="OnFinishClicked"/>
            <Button Text="Clear" Clicked="OnClearClicked"/>

        </HorizontalStackLayout>

    </Grid>
</ContentPage>